<mujoco model="furuta_pendulum">

  <contact>
    <exclude body1="base" body2="arm"/>
    <exclude body1="arm" body2="rod"/>
    <exclude body1="base" body2="rod"/>
  </contact>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1"  diffuse="0.8 0.8 0.8"/>
    <light pos="0.3 0.3 0.8" dir="-1 -1 -1" diffuse="0.4 0.4 0.4"/>

    <!-- Motor body.  Top face of cylinder is at world z = 0.10 + 0.030 = 0.130 m -->
    <body name="base" pos="0 0 0.10">
      <geom type="cylinder" size="0.018 0.030" mass="0.092" rgba="0.35 0.35 0.35 1"/>

      <!-- Arm body origin placed at the top of the motor (the shaft) -->
      <body name="arm" pos="0 0 0.030">
        <!-- Shoulder: arm sweeps the horizontal plane (rotation about Z) -->
        <joint name="shoulder" pos="0 0 0" axis="0 0 1"
               damping="0.00329" limited="true" range="-120 120"
               solreflimit="0.005 1"/>
        <!-- Arm: 40 mm from shoulder pivot to elbow pivot, measured hardware -->
        <geom type="capsule" fromto="0 0 0  0.040 0 0"
              size="0.006" mass="0.030" rgba="0.7 0.5 0.2 1"/>

        <!-- Rod body origin at the elbow pivot (tip of arm) -->
        <body name="rod" pos="0.040 0 0">
          <!-- Elbow: pendulum swings in the vertical plane containing the arm -->
          <!-- qpos=0 is UPRIGHT (+Z); qpos=+/-pi is HANGING (-Z)            -->
          <joint name="elbow" pos="0 0 0" axis="1 0 0" ref="0"/>
          <!-- Rod: 75 mm, pointing +Z at qpos=0 (upright), measured hardware -->
          <geom type="capsule" fromto="0 0 0  0 0 0.075"
                size="0.005" mass="0.025" rgba="0.2 0.5 0.85 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- u in [-1,1] -> shoulder torque in [-0.050, 0.050] N*m (Nidec 24H404H160 at 12V) -->
    <!-- sim_balance_env.py reconfigures this as a velocity servo at runtime              -->
    <motor name="shoulder_motor" joint="shoulder" gear="0.050" ctrlrange="-1 1"/>
  </actuator>

</mujoco>
